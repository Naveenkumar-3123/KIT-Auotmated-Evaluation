# ============================================================================
# EvalAI / KIT Automated Paper Evaluation — Environment Configuration
# Fully Standalone: Cloud Gemini API or Local Models + PostgreSQL / SQLite Fallback
# (Never commit real credentials into version control)
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Vision-Language AI Provider (Default: Google Gemini Cloud API)
# ----------------------------------------------------------------------------
AI_PROVIDER=gemini
MODEL_PROFILE=gemini_flash_lite_latest
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional: For local GPU inference (Qwen-VL) if running without cloud APIs
# AI_PROVIDER=local_transformers
# MODEL_PROFILE=qwen3_vl_8b_local
# MODEL_PATH=models/Qwen3-VL-8B-Instruct-unsloth-bnb-4bit

# ----------------------------------------------------------------------------
# 2. Database Configuration
# ----------------------------------------------------------------------------
# Native PostgreSQL connection. If PostgreSQL is offline, system automatically
# activates the embedded SQLite fallback at data/evalai.db.
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/evalai_db

# ----------------------------------------------------------------------------
# 3. Native JWT Authentication
# ----------------------------------------------------------------------------
JWT_SECRET=evalai-production-super-secret-jwt-key-2026-replace-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ----------------------------------------------------------------------------
# 4. Automated Email Verification via SMTP App Password (Optional)
# ----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM_EMAIL="EvalAI Teacher Workspace <your_email@gmail.com>"
SMTP_USE_TLS=true

# ----------------------------------------------------------------------------
# 5. Local Sandboxed Content-Addressed Storage
# ----------------------------------------------------------------------------
STORAGE_LOCAL_ROOT=data/storage

# ----------------------------------------------------------------------------
# 6. API Server & Frontend Ports
# ----------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8400
API_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
VITE_API_BASE_URL=http://localhost:8400/api
LOG_LEVEL=INFO
